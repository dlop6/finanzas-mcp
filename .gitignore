# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/database/generated/

# next.js
/.next/
/.next-e2e-regression-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Git MCP runtime
/.venv-git-mcp/
/docs/generated/git-demo/

# local Wireshark/TLS capture artifacts
/docs/wireshark/local/

# generated PDF review intermediates
/tmp/pdfs/
