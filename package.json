{
  "name": "finanzas-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:finance:integration": "tsx tests/integration/finance-mcp/run.ts",
    "test:finance:http:integration": "tsx tests/integration/finance-mcp/run-http.ts",
    "test:watch": "vitest",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:host": "tsc --noEmit -p host/tsconfig.json",
    "typecheck:finance": "tsc --noEmit -p servers/finance-mcp/tsconfig.json",
    "typecheck": "npm run typecheck:app && npm run typecheck:host && npm run typecheck:finance",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:seed": "prisma db seed",
    "db:check": "tsx database/check.ts",
    "db:verify": "tsx database/verify.ts",
    "db:repositories:smoke": "tsx database/repository-smoke.ts",
    "db:finance-tools:smoke": "tsx database/finance-tools-smoke.ts",
    "deepseek:smoke": "tsx host/llm/smoke.ts",
    "orchestration:smoke": "tsx host/orchestration/smoke.ts",
    "finance:mcp:http": "tsx servers/finance-mcp/http.ts",
    "git:mcp:setup": "tsx scripts/setup-git-mcp.ts",
    "test:git:integration": "vitest run --config vitest.git.config.mts",
    "demo:e2e": "tsx host/demo/cli.ts",
    "test:e2e:local": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/server-filesystem": "2026.7.10",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "ajv": "8.20.0",
    "dotenv": "17.4.2",
    "next": "16.3.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/pg": "8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "29.1.1",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "4.23.11",
    "typescript": "^5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  }
}
